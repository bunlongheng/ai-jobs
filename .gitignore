# transient / bulky - regenerable per run
*.png
# ...except the app's own committed UI assets (branding + a placeholder avatar). The real
# avatar (web/public/me.png) stays ignored - it's a personal photo; setup seeds a placeholder.
!web/public/icon.png
!web/public/icon-192.png
!web/public/icon-512.png
!web/public/apple-icon.png
!web/public/me.example.png
# README screenshots (sample data only)
!docs/screenshots/*.png
applications/**/*.pdf
applications/**/*.html
applications/**/apply-preview.png
applications/**/apply-result.png
security_code.txt
applications/**/security_code.txt

# logged-in browser session (never commit)
chrome-profile/

# python / node cruft
__pycache__/
*.pyc
node_modules/
.DS_Store

# per-run job snapshots keep only the latest
jobs/2*.json

# application PII artifacts - EEO answers, phone, address (never commit)
applications/**/ext-events.jsonl
applications/**/submitted-answers.json
applications/**/apply-log.json
applications/**/headful-run.log

# local secrets (Stickies key)
.claude/settings.local.json
web/node_modules/
web/.next/
web/jobs.db*
web/test-results/

# ===== personal data - NEVER ship (open-source prep 2026-07-22) =====
applications/
/jobs/
profile.json
resume-*.pdf
answer-bank.md
web/jobs.db*
jobfill/rules.json
jobfill/commands.jsonl
legacy-python/
portals.json
resume-master.md
web/data/recruiters.json

# per-user LaunchAgent plists (contain absolute home paths) - ship the *.example only
com.bheng.jobs*.plist
web/com.bheng.jobs.plist
jobfill/com.bheng.jobfill.plist

# captured application answers (PII - never commit)
jobfill/captured-answers.jsonl

# runtime scan state + generated eval reports (churn every run)
web/public/scan-status.json
.ready-eval.json
.ready-report.json

# dead legacy autonomous-apply bots (retired; extension is the only form-writer)
apply_bot.mjs
dropbox_apply.mjs
login_greenhouse.mjs
