# logged-in browser session (never commit)
chrome-profile/

# python / node cruft
__pycache__/
*.pyc
node_modules/
.DS_Store

# per-run job snapshots keep only the latest
jobs/2*.json

# application PII artifacts - EEO answers, phone, address (never commit)
applications/**/ext-events.jsonl
applications/**/submitted-answers.json
applications/**/apply-log.json
applications/**/headful-run.log

# local secrets (Stickies key)
.claude/settings.local.json
web/node_modules/
web/.next/
web/jobs.db*
web/test-results/

