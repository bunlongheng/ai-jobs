<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.bheng.jobs-backup</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>/path/to/ai-jobs/backup_db.sh</string></array>
  <key>WorkingDirectory</key><string>/path/to/ai-jobs</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/path/to/nvm/bin:/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key><array>
    <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/jobs-backup.log</string>
  <key>StandardErrorPath</key><string>/tmp/jobs-backup.log</string>
</dict></plist>
