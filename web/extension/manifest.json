{
  "manifest_version": 3,
  "name": "JobFill",
  "version": "0.46.0",
  "description": "Fill the open job application page from the local job-hunt kit (the Jobs app (localhost:3017)). You review and click Submit.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:3017/*",
    "http://localhost:3017/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobFill",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  }
}