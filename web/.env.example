# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# All values below are placeholders.

# --- Auth (Auth.js + Google OAuth) ---------------------------------------
# Create an OAuth client at https://console.cloud.google.com (Web application).
# Authorized redirect URI: http://localhost:3017/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Random 32+ char secret: run `openssl rand -base64 32`
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Base URL the app is served from
AUTH_URL=http://localhost:3017
# The ONLY Google account allowed to sign in (single-user gate)
ADMIN_EMAIL=you@example.com

# --- Database ------------------------------------------------------------
# Absolute path to the SQLite file. Defaults to <repo>/web/jobs.db if unset.
JOBS_DB=

# --- Email sending (optional: HN auto-email-apply) -----------------------
# Minted by `node gmail_auth.mjs` (adds gmail.readonly + gmail.send). Leave blank to disable.
GMAIL_REFRESH_TOKEN=
# The name/address applications are sent AS
FROM_NAME=Your Name
FROM_EMAIL=you@example.com

# --- Recruiter email finder (optional: Hunter.io) ------------------------
# Free tier 50/mo: https://hunter.io. Leave blank to disable the find-email button.
HUNTER_API_KEY=

# Optional: pin the extension-only API to your JobFill extension id (chrome://extensions after Load unpacked)
JOBFILL_EXTENSION_ID=
